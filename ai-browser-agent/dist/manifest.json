{
  "manifest_version": 3,
  "name": "GuideDot AI Navigator",
  "description": "A visual, DOM-aware browser guidance assistant.",
  "version": "0.1.0",
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "GuideDot"
  },
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://localhost:3000/*"
  ],
  "content_scripts": [
    {
      "js": [
        "assets/index.ts-CNS89pOu.js"
      ],
      "matches": [
        "<all_urls>"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "<all_urls>"
      ],
      "resources": [
        "assets/index.ts-CNS89pOu.js"
      ],
      "use_dynamic_url": false
    }
  ]
}
